// Generated from dax_measures.dax (the documented source of truth).
// Paste into Power BI Desktop -> DAX query view, click Run, then
// "Update model with changes" to add every measure to the '_Measures' table.
// Requires: the '_Measures' table exists.
DEFINE
    MEASURE '_Measures'[Total Demand GWh] =
        DIVIDE ( SUM ( fact_demand_daily[demand_kwh] ), 1000000 )

    MEASURE '_Measures'[Total Generation GWh] =
        DIVIDE ( SUM ( fact_demand_daily[generation_kwh] ), 1000000 )

    MEASURE '_Measures'[Demand Days] =
        COUNTROWS ( fact_demand_daily )

    MEASURE '_Measures'[Total Demand GWh PY] =
        CALCULATE ( [Total Demand GWh], SAMEPERIODLASTYEAR ( dim_date[date] ) )

    MEASURE '_Measures'[Demand YoY %] =
        VAR CurrentValue = [Total Demand GWh]
        VAR PreviousValue = [Total Demand GWh PY]
        RETURN
            DIVIDE ( CurrentValue - PreviousValue, PreviousValue )

    MEASURE '_Measures'[Demand 7d Avg GWh] =
        VAR LastDate = MAX ( dim_date[date] )
        VAR DateWindow = DATESINPERIOD ( dim_date[date], LastDate, -7, DAY )
        RETURN
            AVERAGEX ( DateWindow, [Total Demand GWh] )

    MEASURE '_Measures'[Demand 28d Avg GWh] =
        VAR LastDate = MAX ( dim_date[date] )
        VAR DateWindow = DATESINPERIOD ( dim_date[date], LastDate, -28, DAY )
        RETURN
            AVERAGEX ( DateWindow, [Total Demand GWh] )

    MEASURE '_Measures'[Demand vs Same Weekday LY GWh] =
        CALCULATE ( [Total Demand GWh], DATEADD ( dim_date[date], -364, DAY ) )

    MEASURE '_Measures'[Demand vs Same Weekday LY %] =
        VAR CurrentValue = [Total Demand GWh]
        VAR PreviousValue = [Demand vs Same Weekday LY GWh]
        RETURN
            DIVIDE ( CurrentValue - PreviousValue, PreviousValue )

    MEASURE '_Measures'[Avg Spot Price] =
        AVERAGE ( fact_market_daily[spot_price_cop_kwh] )

    MEASURE '_Measures'[Avg Spot Price PY] =
        CALCULATE ( [Avg Spot Price], SAMEPERIODLASTYEAR ( dim_date[date] ) )

    MEASURE '_Measures'[Price YoY %] =
        VAR CurrentValue = [Avg Spot Price]
        VAR PreviousValue = [Avg Spot Price PY]
        RETURN
            DIVIDE ( CurrentValue - PreviousValue, PreviousValue )

    MEASURE '_Measures'[Demand-weighted Spot Price] =
        VAR Weighted =
            SUMX (
                VALUES ( dim_date[date_key] ),
                [Total Demand GWh] * [Avg Spot Price]
            )
        VAR TotalDemand =
            SUMX (
                FILTER ( VALUES ( dim_date[date_key] ), NOT ISBLANK ( [Avg Spot Price] ) ),
                [Total Demand GWh]
            )
        RETURN
            DIVIDE ( Weighted, TotalDemand )

    MEASURE '_Measures'[Price-Demand Correlation] =
        VAR Daily =
            FILTER (
                ADDCOLUMNS (
                    VALUES ( dim_date[date_key] ),
                    "@x", [Total Demand GWh],
                    "@y", [Avg Spot Price]
                ),
                NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
            )
        VAR N = COUNTROWS ( Daily )
        VAR Sx = SUMX ( Daily, [@x] )
        VAR Sy = SUMX ( Daily, [@y] )
        VAR Sxy = SUMX ( Daily, [@x] * [@y] )
        VAR Sxx = SUMX ( Daily, [@x] * [@x] )
        VAR Syy = SUMX ( Daily, [@y] * [@y] )
        VAR Numerator = N * Sxy - Sx * Sy
        VAR Denominator = SQRT ( ( N * Sxx - Sx * Sx ) * ( N * Syy - Sy * Sy ) )
        RETURN
            IF ( N > 2, DIVIDE ( Numerator, Denominator ) )

    MEASURE '_Measures'[Reservoir %] =
        LASTNONBLANKVALUE (
            dim_date[date],
            CALCULATE ( MAX ( fact_market_daily[reservoir_pct] ) )
        )

    MEASURE '_Measures'[Inflows GWh] =
        DIVIDE ( SUM ( fact_market_daily[inflows_kwh] ), 1000000 )

    MEASURE '_Measures'[Avg Daily Inflows GWh] =
        DIVIDE ( SUM ( fact_market_daily[inflows_kwh] ), 1000000 * COUNTROWS ( fact_market_daily ) )

    MEASURE '_Measures'[Inflows vs Historical] =
        VAR HistoricalAvg =
            CALCULATE (
                [Avg Daily Inflows GWh],
                REMOVEFILTERS (
                    dim_date[year],
                    dim_date[year_month],
                    dim_date[quarter],
                    dim_date[iso_week],
                    dim_date[date],
                    dim_date[date_key]
                ),
                VALUES ( dim_date[month] )
            )
        RETURN
            DIVIDE ( [Avg Daily Inflows GWh], HistoricalAvg )

    MEASURE '_Measures'[Avg ONI] =
        AVERAGE ( dim_enso_monthly[oni_anom] )

    MEASURE '_Measures'[Exports GWh] =
        DIVIDE ( SUM ( fact_demand_daily[exports_kwh] ), 1000000 )

    MEASURE '_Measures'[Imports GWh] =
        DIVIDE ( SUM ( fact_demand_daily[imports_kwh] ), 1000000 )

    MEASURE '_Measures'[Net Imports GWh] =
        [Imports GWh] - [Exports GWh]

    MEASURE '_Measures'[Unserved Energy GWh] =
        DIVIDE ( SUM ( fact_demand_daily[unserved_kwh] ), 1000000 )

    MEASURE '_Measures'[Unserved Energy Share] =
        DIVIDE (
            SUM ( fact_demand_daily[unserved_kwh] ),
            SUM ( fact_demand_daily[demand_kwh] ) + SUM ( fact_demand_daily[unserved_kwh] )
        )

    MEASURE '_Measures'[Scored Predictions] =
        COUNT ( fact_prediction[actual_kwh] )

    MEASURE '_Measures'[Model MAE GWh] =
        DIVIDE (
            SUMX (
                FILTER ( fact_prediction, NOT ISBLANK ( fact_prediction[actual_kwh] ) ),
                ABS ( fact_prediction[predicted_kwh] - fact_prediction[actual_kwh] )
            ),
            [Scored Predictions] * 1000000
        )

    MEASURE '_Measures'[Model WAPE] =
        VAR Scored = FILTER ( fact_prediction, NOT ISBLANK ( fact_prediction[actual_kwh] ) )
        RETURN
            DIVIDE (
                SUMX ( Scored, ABS ( fact_prediction[predicted_kwh] - fact_prediction[actual_kwh] ) ),
                SUMX ( Scored, fact_prediction[actual_kwh] )
            )

    MEASURE '_Measures'[Model Bias %] =
        VAR Scored = FILTER ( fact_prediction, NOT ISBLANK ( fact_prediction[actual_kwh] ) )
        RETURN
            DIVIDE (
                SUMX ( Scored, fact_prediction[predicted_kwh] - fact_prediction[actual_kwh] ),
                SUMX ( Scored, fact_prediction[actual_kwh] )
            )

    MEASURE '_Measures'[Accuracy %] =
        IF ( NOT ISBLANK ( [Model WAPE] ), 1 - [Model WAPE] )

    MEASURE '_Measures'[Rolling 30d WAPE] =
        VAR LastDate = MAX ( dim_date[date] )
        VAR DateWindow = DATESINPERIOD ( dim_date[date], LastDate, -30, DAY )
        RETURN
            CALCULATE ( [Model WAPE], DateWindow )

    MEASURE '_Measures'[Price Elasticity Assumption] =
        -0.10

EVALUATE ROW ( "Total Demand GWh", [Total Demand GWh] )
