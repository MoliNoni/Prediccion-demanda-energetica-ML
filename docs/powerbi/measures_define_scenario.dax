// Generated from dax_measures.dax (the documented source of truth).
// Paste into Power BI Desktop -> DAX query view, click Run, then
// "Update model with changes" to add every measure to the '_Measures' table.
// Requires: the 'Price shock %' what-if parameter exists (Modeling -> New parameter).
DEFINE
    MEASURE '_Measures'[Scenario Price] =
        [Avg Spot Price] * ( 1 + 'Price shock %'[Price shock % Value] / 100 )

    MEASURE '_Measures'[Scenario Demand GWh] =
        VAR Shock = 'Price shock %'[Price shock % Value] / 100
        RETURN
            [Total Demand GWh] * ( 1 + [Price Elasticity Assumption] * Shock )

    MEASURE '_Measures'[Scenario Demand Delta GWh] =
        [Scenario Demand GWh] - [Total Demand GWh]

EVALUATE ROW ( "Scenario Price", [Scenario Price] )
